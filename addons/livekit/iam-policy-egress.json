{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LivekitEgressS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::<S3_RECORDINGS_BUCKET>",
        "arn:aws:s3:::<S3_RECORDINGS_BUCKET>/*"
      ]
    }
  ]
}
